# Copiar como .env para cambiar valores (opcional: sin .env se usan estos mismos por defecto).

# Credenciales de desarrollo
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo
RABBITMQ_DEFAULT_USER=demo
RABBITMQ_DEFAULT_PASS=demo

# Puertos en tu PC. Si la API de M2 del TPI ya está usando el 8000, poné API_PORT=8001.
API_PORT=8000
POSTGRES_PORT=5432

# Segundos que tarda el worker en "buscar un conductor" y cada cuánto revisa el relay el outbox
TIEMPO_PROCESAMIENTO=3
INTERVALO_RELAY=1
